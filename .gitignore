# --- artefacts lourds (générés, non versionnés) ----------------------------
# packages extraits / patchés, tests IoStore
build/
# WAV VOICEVOX (out/jp_events) et .wem (out/jp_wem)
out/
# modèle de traduction local (opus-mt-zh-ja, ~300 Mo)
models/
# moteur VOICEVOX Engine
voicevox/
# journaux d'exécution
logs/
# wheels d'analyse (vgmstream, pywwise)
tools_dec/
# encodeur aoTuV (binaire tiers)
tools/*.exe
tools/*.whl
tools/packed_codebooks_aoTuV_603.bin

# --- artefacts de travail ---------------------------------------------------
*.wav
!data/samples/*.wav
*.wem
*.ogg
*.ucas
*.utoc
*.pak
*.log
__pycache__/
*.pyc
data/manifest_jp.csv.bak
data/jp_durations.json

# --- artefacts regeneres ----------------------------------------------------
# liste des fichiers du conteneur (produite par src/patch/container_files.py)
data/container_files.tsv
# rapport du patch des durees (produit par src/patch/patch_dt_durations.py)
data/dt_duration_patch.json
# durees mesurees sur les .wem injectes (produit par src/audio/wem_durations.py)
data/jp_wem_durations.json
# Ces trois fichiers ne sont plus ignores : ils portent les choix de doublage
# (personnage -> style VOICEVOX) et doivent etre versionnes pour etre
# revus et corriges event au event.
#  data/event_speaker.json     evenement -> personnage (src/translate/loc_dump.py)
#  data/character_voices.json  personnage -> style VOICEVOX (src/tts/voice_assign.py)
#  data/voicevox_styles.json   styles du moteur VOICEVOX (src/tts/voicevox_styles.py)
# vitesses de synthese par evenement (produit par src/tts/tts_align.py)
data/jp_speeds.json

# --- secrets / chemins locaux ----------------------------------------------
# contient la clé AES du jeu : ne jamais commiter
pbz_paths.txt

# --- divers -----------------------------------------------------------------
.DS_Store
Thumbs.db

# copies locales de la configuration C#
tools/csharp/*/pbz_paths.txt

# sorties de compilation des outils C#
tools/csharp/*/bin/
tools/csharp/*/obj/
tools/csharp/*/build/

# liste vide utilisée pour créer le .pak du mod
build/empty_list.txt

# sondes de diagnostic jetables
tools/csharp/city/
